{
  "name": "dsh-littlestar-anything-voice",
  "version": "1.12.8",
  "description": "小星辰任意语音：Q 版立绘挂件 + 本地 IndexTTS 声音克隆，一个角色一段参考音频，点一下就念 / 再点就闭嘴",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/images/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theskywilldawn/dsh-littlestar-anything-voice.git"
  },
  "homepage": "https://github.com/theskywilldawn/dsh-littlestar-anything-voice#readme",
  "bugs": {
    "url": "https://github.com/theskywilldawn/dsh-littlestar-anything-voice/issues"
  },
  "author": "theskywilldawn",
  "license": "MIT"
}
